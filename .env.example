# Frontend: configuración pública expuesta en el bundle por Vite
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_auth_domain
VITE_FIREBASE_PROJECT_ID=tu_project_id
VITE_FIREBASE_STORAGE_BUCKET=tu_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
VITE_FIREBASE_MEASUREMENT_ID=tu_measurement_id
# Opcional: vacía usa la Function del mismo dominio en /api/presign-upload
VITE_UPLOAD_API_URL=

# Backend: cargar solo en Vercel Functions; Firebase usa los mismos valores públicos del frontend
FIREBASE_API_KEY=tu_api_key
FIREBASE_PROJECT_ID=tu_project_id
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key

# Configuración del bucket S3 usado por la Function
S3_BUCKET=kairo-products
S3_REGION=us-east-2
S3_PUBLIC_BASE_URL=https://kairo-products.s3.us-east-2.amazonaws.com
# Opcional: solo necesario si el navegador llama a la API desde otro origen
ALLOWED_ORIGIN=https://proyecto-m5-caceres-diego.vercel.app