rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function reviewPurchaseIsValid(productId, orderId, itemIndex) {
      return orderId is string
        && itemIndex is int
        && itemIndex >= 0
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status in ['pending', 'processing', 'completed']
        && get(/databases/$(database)/documents/orders/$(orderId)).data.items is list
        && itemIndex < get(/databases/$(database)/documents/orders/$(orderId)).data.items.size()
        && get(/databases/$(database)/documents/orders/$(orderId)).data.items[itemIndex].productId == productId;
    }

    // El descuento de stock debe corresponder a un ítem de una orden propia creada en esta misma transacción.
    function stockChangeMatchesNewOrder(productId) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId);
      let order = getAfter(orderPath).data;
      let item = order.items[request.resource.data.lastOrderItemIndex];
      return !exists(orderPath)
        && order.userId == request.auth.uid
        && item.productId == productId
        && item.quantity == resource.data.stock - request.resource.data.stock
        && item.priceAtPurchase == resource.data.price;
    }

    // El agregado debe corresponder a la reseña propia escrita en esta misma transacción.
    // Cada promedio se redondea a 2 decimales, de ahí la tolerancia por reseña.
    function ratingChangeMatchesOwnReview(productId) {
      let reviewPath = /databases/$(database)/documents/reviews/$(request.auth.uid + '_' + productId);
      let review = getAfter(reviewPath).data;
      let oldCount = resource.data.get('ratingCount', 0);
      let oldSum = resource.data.get('rating', 0) * oldCount;
      let nextCount = request.resource.data.ratingCount;
      let nextSum = request.resource.data.rating * nextCount;
      let tolerance = 0.0051 * nextCount;
      return review.userId == request.auth.uid
        && (review.get('updatedAt', null) == request.time || review.get('createdAt', null) == request.time)
        && (
          // Edición de una reseña existente.
          (exists(reviewPath)
            && nextCount == oldCount
            && math.abs(nextSum - (oldSum - get(reviewPath).data.rating + review.rating)) <= tolerance)
          // Reseña nueva.
          || (!exists(reviewPath)
            && nextCount == oldCount + 1
            && math.abs(nextSum - (oldSum + review.rating)) <= tolerance)
          // Migración de una reseña con ID antiguo: la anterior vale entre 1 y 5 y las reglas no conocen su ID.
          || (!exists(reviewPath)
            && nextCount == oldCount
            && nextSum >= oldSum + review.rating - 5 - tolerance
            && nextSum <= oldSum + review.rating - 1 + tolerance)
        );
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt']);

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
      );

      allow delete: if isAdmin();
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if true; // catálogo público
      allow create, delete: if isAdmin();

      // Un cliente solo puede descontar stock al crear su orden o actualizar el promedio al guardar su reseña.
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastOrderId', 'lastOrderItemIndex'])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.lastOrderId is string
          && request.resource.data.lastOrderItemIndex is int
          && request.resource.data.lastOrderItemIndex >= 0
          && stockChangeMatchesNewOrder(productId))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.ratingCount is int
          && request.resource.data.ratingCount > 0
          && ratingChangeMatchesOwnReview(productId));
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      // El total lo calcula el cliente dentro de una transacción; las reglas no pueden recorrer items.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','userEmail','customerName','items','total','status','history','shippingAddress','payment','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.createdAt == request.time;

      // Admin ve todas, usuario solo las suyas
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      // Solo admin puede modificar o borrar
      allow update, delete: if isAdmin();
    }

    // --- CARRITO Y FAVORITOS (privados de cada usuario) ---
    match /carts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.updatedAt == request.time;
    }

    match /favorites/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // --- DIRECCIÓN DE ENVÍO (privada de cada usuario; los límites coinciden con el formulario) ---
    match /shippingAddresses/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['fullName', 'address', 'city', 'postalCode', 'phone', 'updatedAt'])
        && request.resource.data.keys().hasAll(['fullName', 'address', 'city', 'postalCode', 'phone', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 200
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 100
        && request.resource.data.postalCode is string
        && request.resource.data.postalCode.size() > 0
        && request.resource.data.postalCode.size() <= 20
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;

      // Un comprador tiene una reseña identificada por usuario y producto, y puede editarla.
      allow create: if signedIn()
        && request.resource.data.productId is string
        && reviewId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['productId','userId','userName','rating','comment','orderId','orderItemIndex','createdAt','updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.userName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && request.resource.data.createdAt == request.time
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
        && reviewPurchaseIsValid(request.resource.data.productId, request.resource.data.orderId, request.resource.data.orderItemIndex);

      allow update: if signedIn()
        && reviewId == request.auth.uid + '_' + resource.data.productId
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['productId','userId','userName','rating','comment','orderId','orderItemIndex','createdAt','updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','comment','orderId','orderItemIndex','updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && reviewPurchaseIsValid(request.resource.data.productId, request.resource.data.orderId, request.resource.data.orderItemIndex);

      // El autor solo puede borrar reseñas con ID antiguo (migración): borrar y volver a crear inflaría ratingCount.
      allow delete: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && reviewId != request.auth.uid + '_' + resource.data.productId);
    }
  }
}